{
  "name": "flutter-genius",
  "displayName": "Flutter Genius",
  "description": "Flutter Genius: Streamline your Flutter development with automated folder structures, feature generation, and JSON to Dart class conversion.",
  "publisher": "AlexxyQQ",
  "author": {
    "name": "Aayush Pandey",
    "url": "https://github.com/alexxyqq",
    "email": "aayushpandey616+flutterGenius@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexxyQQ/flutter-genius"
  },
  "version": "0.2.2",
  "engines": {
    "vscode": "^1.87.0"
  },
  "icon": "assets/temp-icon.png",
  "categories": [
    "Snippets",
    "Programming Languages"
  ],
  "keywords": [
    "dart",
    "flutter",
    "dart class",
    "flutter class",
    "feature-driven",
    "feature-driven architecture",
    "feature-driven development",
    "feature-driven design",
    "feature folder structure generator",
    "bloc",
    "state-management",
    "dart data class generator",
    "dart data class",
    "dart data",
    "dart",
    "data class generator",
    "value getter"
  ],
  "activationEvents": [
    "onLanguage:plaintext",
    "onLanguage:dart"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flutter-genius.generateEntityToModel",
        "title": "Flutter Genius: Generate Model from Entity"
      },
      {
        "command": "flutter-genius.separateClasses",
        "title": "Flutter Genius: Separate Classes"
      }
    ],
    "menus": {
      "explorer/context": [],
      "editor/context": [
        {
          "command": "flutter-genius.generateEntityToModel",
          "when": "editorLangId == dart",
          "group": "flutter-genius@1"
        },
        {
          "command": "flutter-genius.separateClasses",
          "when": "editorLangId == dart",
          "group": "flutter-genius@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.87.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vscode/test-cli": "^0.0.6",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.56.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4"
  }
}
